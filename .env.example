# ---------------------------------------------------------------------------
# Ejentic Agents — environment template
#
# Copy this to `.env` and fill in real values:   cp .env.example .env
# NEVER commit your real `.env` (it's gitignored). This file holds placeholders.
# ---------------------------------------------------------------------------

# --- Shared brains -----------------------------------------------------------
# Reuse the same GEMINI key from your ai-agency/.env.
GEMINI_API_KEY="your-gemini-api-key"

# Which Gemini model to use. Default is a fast model with generous free quota.
# NOTE: the free tier is per-model, per-day. gemini-2.5-flash is only ~20
# requests/day; gemini-flash-lite-latest has much more headroom and is plenty for
# screening + drafting. Run `npm run probe-models` to see which have quota today.
GEMINI_MODEL="gemini-flash-lite-latest"

# FIRECRAWL_API_KEY — required by the Scholarship agent (#2) and Researcher
# agent (#3), which discover things via web search. Get a free key at
# https://firecrawl.dev  (the Job agent does NOT need it).
FIRECRAWL_API_KEY=""

# --- Telegram bot #1 : the Job agent ---------------------------------------
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token it gives you.
# 2. Send your new bot any message (e.g. "hi") so it can find your chat.
# 3. Run:  npm run chat-id   -> paste the number it prints into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID=""

# --- Telegram bot #2 : the Content agent (agent #4) --------------------------
# A DEDICATED bot so content drafts never mix with research/job digests.
# 1. Talk to @BotFather -> /newbot -> name it (e.g. "Ejentic Content Studio").
# 2. Send the new bot any message (e.g. "hi"), then run: npm run chat-id
# 3. Paste the token + your chat id here and in the GitHub secrets as
#    TELEGRAM_CONTENT_BOT_TOKEN / TELEGRAM_CONTENT_CHAT_ID.
# (If left empty, the content agent falls back to the main bot with a warning —
#  handy for testing, but create the dedicated bot before going live.)
TELEGRAM_CONTENT_BOT_TOKEN=""
TELEGRAM_CONTENT_CHAT_ID=""

# --- Content agent tuning (safe defaults) ------------------------------------
# How many days back to mine the research agent's findings for source material.
RESEARCH_LOOKBACK_DAYS="3"
# How many research articles to scrape and feed into each content run.
RESEARCH_PER_RUN="2"
# Where the "book a consultation" CTAs should point (leave empty for a placeholder).
CONSULTATION_URL=""

# --- Optional tuning (safe defaults; leave as-is to stay in the free tier) --
MAX_JOBS="4"
MAX_LEADS="4"
MAX_SCHOLARSHIPS="5"
MAX_RESEARCH="5"
