# ---------------------------------------------------------------------------
# Ejentic Agents — environment template
#
# Copy this to `.env` and fill in real values:   cp .env.example .env
# NEVER commit your real `.env` (it's gitignored). This file holds placeholders.
# ---------------------------------------------------------------------------

# --- Shared brains -----------------------------------------------------------
# Reuse the same GEMINI key from your ai-agency/.env.
GEMINI_API_KEY="your-gemini-api-key"

# Which Gemini model to use. Default is a fast model with generous free quota.
# NOTE: the free tier is per-model, per-day. gemini-2.5-flash is only ~20
# requests/day; gemini-flash-lite-latest has much more headroom and is plenty for
# screening + drafting. Run `npm run probe-models` to see which have quota today.
GEMINI_MODEL="gemini-flash-lite-latest"

# FIRECRAWL_API_KEY — required by the Scholarship agent (#2) and Researcher
# agent (#3), which discover things via web search. Get a free key at
# https://firecrawl.dev  (the Job agent does NOT need it).
FIRECRAWL_API_KEY=""

# --- Telegram bot #1 : the Job agent ---------------------------------------
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token it gives you.
# 2. Send your new bot any message (e.g. "hi") so it can find your chat.
# 3. Run:  npm run chat-id   -> paste the number it prints into TELEGRAM_CHAT_ID.
#
# TELEGRAM_CHAT_ID is NOT really optional — it is the "who am I sending to?"
# setting. Left empty, the code falls back to whoever last messaged the bot, and
# Telegram bots are searchable by username, so a stranger who sends yours "hi"
# becomes that person and receives your digests. The fallback is allowed only in
# a local interactive run (it prints a warning + the chat it picked); in CI the
# agents now REFUSE to run without this set, which is the behaviour you want.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID=""

# --- Telegram bot #2 : the Content agent (agent #4) --------------------------
# A DEDICATED bot so content drafts never mix with research/job digests.
# 1. Talk to @BotFather -> /newbot -> name it (e.g. "Ejentic Content Studio").
# 2. Send the new bot any message (e.g. "hi"), then run: npm run chat-id
# 3. Paste the token + your chat id here and in the GitHub secrets as
#    TELEGRAM_CONTENT_BOT_TOKEN / TELEGRAM_CONTENT_CHAT_ID.
# (If the TOKEN is left empty, the content agent falls back to the main bot with a
#  warning — handy for testing, but create the dedicated bot before going live.)
#
# TELEGRAM_CONTENT_CHAT_ID empty is a RECIPIENT-HIJACK RISK in CI, not a mere
# "optional". The content agent falls back to TELEGRAM_CHAT_ID and then to
# auto-detecting whoever last messaged the content bot — which means a stranger
# who messages that bot could be sent your content drafts, brand strategy and
# founder personas. Set this (or at minimum TELEGRAM_CHAT_ID) in your GitHub
# Actions secrets; the scheduled run now fails loudly instead of guessing.
TELEGRAM_CONTENT_BOT_TOKEN=""
TELEGRAM_CONTENT_CHAT_ID=""

# --- Content agent tuning (safe defaults) ------------------------------------
# How many days back to mine the research agent's findings for source material.
RESEARCH_LOOKBACK_DAYS="3"
# How many research articles to scrape and feed into each content run.
RESEARCH_PER_RUN="2"
# Where the "book a consultation" CTAs should point (leave empty for a placeholder).
CONSULTATION_URL=""
# Day 1 of the 30-day content cycle (ISO date). The cycle counts forward from
# here so the narrative always runs in order. Leave empty to use the built-in
# default (src/context/calendar.ts DEFAULT_CYCLE_START).
CONTENT_CYCLE_START=""
# Optional stronger model JUST for drafting + rewriting (e.g. gemini-2.5-flash).
# Leave empty to use GEMINI_MODEL. The editor's SCORING always runs on the cheap
# default to save free-tier quota.
CONTENT_MODEL=""
# The editor rewrites a draft once if it scores below this (out of 10). Higher =
# stricter (more rewrites, more quota). Default 8.
CONTENT_QUALITY_GATE="8"

# --- Website ingest bridge (weekly newsletter) -----------------------------
# After each finished post, the agent MIRRORS it to the website's locked-down
# ingest endpoint, which stores it for the weekly "Enterprise AI Playbook"
# newsletter. This is BEST-EFFORT and OFF by default: leave either var empty and
# the agent skips the mirror silently (data/content-posts.json stays the source
# of truth). Set BOTH to turn it on once the website endpoint is live.
#   URL   = the app's ingest route, e.g. https://ejentic.ai/api/content/ingest
#   TOKEN = must EXACTLY match CONTENT_INGEST_TOKEN in the website's .env
CONTENT_INGEST_URL=""
CONTENT_INGEST_TOKEN=""

# --- Optional tuning (safe defaults; leave as-is to stay in the free tier) --
MAX_JOBS="4"
MAX_LEADS="4"
MAX_SCHOLARSHIPS="5"
MAX_RESEARCH="5"
