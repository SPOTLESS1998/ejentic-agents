# dependencies
node_modules/

# secrets — never commit real keys/tokens. Only the template is tracked.
.env
.env.local
!.env.example

# your private profile — real name, phone, email, and what you sell. Only the
# *.example.json templates are tracked, which is what lets this repo be public.
profile/*.json
!profile/*.example.json

# logs / os junk
*.log
.DS_Store

# NOTE: data/seen-*.json, data/content-posts.json and the run log
# (data/run-log.jsonl + the generated data/AGENT-LOG.md) are intentionally NOT
# ignored — they are the fleet's memory and its history, and they must persist
# between runs. The workflows commit data/ back to the repo after each run.

# Local env backups (never commit — may hold retired keys)
*.env.bak-*
