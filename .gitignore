# dependencies
node_modules/

# secrets — never commit real keys/tokens. Only the template is tracked.
.env
.env.local
!.env.example

# your private profile — real name, phone, email, and what you sell. Only the
# *.example.json templates are tracked, which is what lets this repo be public.
profile/*.json
!profile/*.example.json

# logs / os junk
*.log
.DS_Store

# NOTE: data/seen-*.json is intentionally NOT ignored — it stores which
# opportunities were already reported, so it must persist between runs.
